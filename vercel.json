{
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "style.css", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "src/**", "use": "@vercel/static" },
    { "src": "vendor/**", "use": "@vercel/static" }
  ],
  "rewrites": [{ "source": "/api/:action(bank|session|events|feedback|review|refresh)", "destination": "/api/:action.js" }],
  "crons": [{ "path": "/api/refresh", "schedule": "0 16 * * *" }]
}
