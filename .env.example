# Server-only values. Configure these in the game's Vercel project.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
# Use at least 32 random characters. Vercel also uses this to authenticate cron.
CRON_SECRET=
# LLM answer review (runs during the daily automated bank update, replacing community votes).
# Uses an OpenAI-compatible chat endpoint. OpenRouter free models work well.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nex-agi/nex-n2.5-pro:free
